# Pick one: anthropic | openai-compatible | demo (default when nothing is configured)
AURA_PROVIDER=demo

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Any OpenAI-style /chat/completions endpoint (Nebius Token Factory, Gemini's
# OpenAI-compatible endpoint, a self-hosted vLLM, ...). Use a vision model if you
# want photos read, not just colors and words.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Footer links
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_BENCHMARK_URL=
